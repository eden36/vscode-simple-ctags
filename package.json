{
  "name": "simple-ctags",
  "displayName": "simple ctags",
  "description": "基于已有经典 tags 文件的轻量、语言无关定义跳转。",
  "version": "0.1.2",
  "publisher": "saltcoreyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eden36/vscode-simple-ctags"
  },
  "bugs": {
    "url": "https://github.com/eden36/vscode-simple-ctags/issues"
  },
  "homepage": "https://github.com/eden36/vscode-simple-ctags",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ctags",
    "navigation",
    "definition"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "simpleCtags.goToDefinition",
        "title": "simple ctags: 跳转到当前符号定义"
      },
      {
        "command": "simpleCtags.clearCache",
        "title": "simple ctags: 清理缓存"
      },
      {
        "command": "simpleCtags.diagnoseCurrentSymbol",
        "title": "simple ctags: 诊断当前符号"
      },
      {
        "command": "simpleCtags.generateTags",
        "title": "simple ctags: 生成或更新 Tags"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "simpleCtags.generateTags",
          "when": "editorTextFocus && workspaceFolderCount != 0 && isWorkspaceTrusted",
          "group": "z_simpleCtags@9999"
        }
      ]
    },
    "configuration": {
      "title": "simple ctags",
      "properties": {
        "simpleCtags.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用“跳转到当前符号定义”命令。"
        },
        "simpleCtags.tagFileNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".tags",
            "tags"
          ],
          "minItems": 1,
          "description": "按优先级查找的 tags 文件名。只允许文件名。"
        },
        "simpleCtags.maxResults": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 200,
          "description": "单次定义请求返回的最大候选数。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "debug": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run build",
    "check": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "test": "npm run check && mocha --require ts-node/register --require source-map-support/register \"test/unit/**/*.test.ts\"",
    "test:integration": "npm run build && tsc && node out/test/runTest.js",
    "generate:icon": "node scripts/generate-icon.mjs",
    "package": "npm run check && npm run lint && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "mocha": "^10.7.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
